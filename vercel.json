{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ecode/472:suffix([a-fA-F])",
      "destination": "/ecode/472",
      "permanent": true
    },
    {
      "source": "/ecode/150:suffix([a-dA-D])",
      "destination": "/ecode/150",
      "permanent": true
    },
    {
      "source": "/ecode/407:suffix([aA])",
      "destination": "/ecode/407",
      "permanent": true
    },
    {
      "source": "/ecode/E:code(\\d{3,4}[a-z]?)",
      "destination": "/ecode/:code",
      "permanent": true
    },
    {
      "source": "/ecode/e:code(\\d{3,4}[a-z]?)",
      "destination": "/ecode/:code",
      "permanent": true
    },
    {
      "source": "/E:code(\\d{3,4}[a-z]?)",
      "destination": "/ecode/:code",
      "permanent": true
    },
    {
      "source": "/e:code(\\d{3,4}[a-z]?)",
      "destination": "/ecode/:code",
      "permanent": true
    },
    {
      "source": "/halal-check-e:code(\\d{3,4}[a-z]?)-:rest*",
      "destination": "/ecode/:code",
      "permanent": true
    },
    {
      "source": "/halal-check-E:code(\\d{3,4}[a-z]?)-:rest*",
      "destination": "/ecode/:code",
      "permanent": true
    },
    {
      "source": "/e:code(\\d{3,4}[a-z]?)-:rest*",
      "destination": "/ecode/:code",
      "permanent": true
    },
    {
      "source": "/E:code(\\d{3,4}[a-z]?)-:rest*",
      "destination": "/ecode/:code",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|webp|svg|ico|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
